<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Regression suite: every test, selected via the "regression" group. Run with:
      mvn test -Dsurefire.suiteXmlFiles=testng-regression.xml
  Note: EmployeeTest needs a local json-server on :3000, and AuthTest needs the
  private auth server, so run regression against an environment where those are
  reachable (e.g. -Denv=qa with the services up).
-->
<suite name="Regression Suite" verbose="1">
    <test name="regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="apitests.SerializationTest"/>
            <class name="apitests.ReqresTest"/>
            <class name="apitests.EmployeeTest"/>
            <class name="apitests.AuthTest"/>
            <class name="apitests.StoreTest"/>
            <class name="uitests.SauceLoginTest"/>
        </classes>
    </test>
</suite>
