<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Smoke suite: fast, CI-safe critical checks (one offline + one public API + one UI).
  Selected via the "smoke" group. Run with:
      mvn test -Dsurefire.suiteXmlFiles=testng-smoke.xml
-->
<suite name="Smoke Suite" verbose="1">
    <test name="smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="SerializationDeserialization"/>
            <class name="apitests.StoreTest"/>
            <class name="uitests.SauceLoginTest"/>
        </classes>
    </test>
</suite>
