<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  All API-layer tests. Run with:  mvn test -Dsurefire.suiteXmlFiles=testng-api.xml
  Note: EmployeeTest needs a local json-server on :3000, and AuthTest needs the
  private auth server.
-->
<suite name="API Suite" verbose="1">
    <test name="api">
        <classes>
            <class name="apitests.SerializationTest"/>
            <class name="apitests.ReqresTest"/>
            <class name="apitests.EmployeeTest"/>
            <class name="apitests.AuthTest"/>
            <class name="apitests.StoreTest"/>
        </classes>
    </test>
</suite>
